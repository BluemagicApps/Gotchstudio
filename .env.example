# Copy to `.env` for local development. None of these are required to run the
# static site; they enable the optional database + API integrations.

# Public site URL (used for canonical/OG/sitemap). Override per environment.
NEXT_PUBLIC_SITE_URL="https://gotchstudio.com"

# Optional Node API base (see server/README.md). Leave unset to use mocks.
# NEXT_PUBLIC_API_URL="http://localhost:4000"

# Prisma / SQLite (only needed if you run the optional server).
# DATABASE_URL="file:./gotch.db"

# Future AI integrations (server-side only — never expose secret keys client-side):
# REPLICATE_API_TOKEN=""
# HUGGINGFACE_API_KEY=""
# ANTHROPIC_API_KEY=""
# MAILCHIMP_API_KEY=""
