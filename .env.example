# Copy to `.env` (or `.env.local` for dev). The site runs fine with NONE of the
# AI keys set — every AI tool falls back gracefully to a tasteful demo. Add keys
# to switch the tools to live generation.

# ── Site ─────────────────────────────────────────────────────────────────────
# Public site URL (canonical/OG/sitemap). Set to your real domain in production.
NEXT_PUBLIC_SITE_URL="https://gotchstudio.com"

# ── AI Studio: Design Concierge + Style Profile (Claude) ─────────────────────
# Server-side only — never expose this to the browser. Without it the concierge
# uses scripted replies and the style profile uses a static fallback.
ANTHROPIC_API_KEY=""
# Optional: override the model (defaults to claude-opus-4-8).
# ANTHROPIC_MODEL="claude-opus-4-8"

# ── AI Studio: Room Visualizer + Virtual Staging (Replicate) ─────────────────
# Server-side only. Without it the image tools show curated reference imagery.
REPLICATE_API_TOKEN=""
# Default model is "adirik/interior-design" (unpinned — Replicate resolves the
# latest version automatically). Optionally pin a specific "owner/name:version"
# for reproducibility, or point at a different model.
# REPLICATE_VISUALIZE_MODEL="adirik/interior-design"
# REPLICATE_STAGE_MODEL="adirik/interior-design"

# ── Backend database (inquiries, bookings, subscribers, audit log) ───────────
# Required for the contact / booking / newsletter forms to persist data.
# SQLite by default (file resolved relative to prisma/). For Postgres/MySQL,
# change `provider` in prisma/schema.prisma and use that connection string.
# After setting this, run: npm run db:migrate   (or `npm run db:push` in dev)
DATABASE_URL="file:./gotch.db"

# ── Admin / data export (auditing + marketing) ───────────────────────────────
# Bearer token guarding /api/admin/* (stats + CSV/JSON exports). Generate a long
# random value in production; if unset, admin endpoints return 503 (disabled).
ADMIN_API_KEY=""
# Salt used to hash visitor IPs in the audit log (we never store raw IPs).
AUDIT_SALT=""

# ── Runtime ──────────────────────────────────────────────────────────────────
# Port the Node server listens on (Nginx proxies to this). Defaults to 3000.
# PORT="3000"
